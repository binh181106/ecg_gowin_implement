    "f_peak/f_max": "max(x)",
    "f_ptp": "max(x)-min(x)",
    "f_zc": "adjacent sign changes only; zero nonnegative; no artificial first crossing",
    "f_crest": "sign(max(x))*floor(abs(max(x))*65536/R), R=0 -> 0; F=8; absolute crest pending",

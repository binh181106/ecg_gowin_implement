  "formulas": {
    "f_rms": "R=isqrt(sum(x*x)*128); f_rms=R//256; F=0",
    "f_var": "floor((512*sum(x*x)-sum(x)^2)/262144); F=0; saturate 0..32767, fault on negative",
    "f_peak/f_max": "max(x)",
    "f_ptp": "max(x)-min(x)",
    "f_zc": "opposite adjacent signs after deleting zeros",
    "f_crest": "min(32767,max(abs(x))*65536//R), R=0 -> 0; nonnegative F=8",
    "f_half_ratio": "count(x>=0)*8; F=12",
    "rr": "signed positive local maximum; refractory72; continuous timestamp differences; timeout1800",
    "f_rr_ratio": "pair_valid ? min(32767,current*4096//previous) : 0; F=12",
    "f_rr_diff": "pair_valid ? current-previous : 0; signed samples",
    "f_rr": "latest valid continuous interval, samples; otherwise0",
    "f_rr_prev": "previous valid continuous interval, samples; otherwise0"
  },
